<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typographie TrackGo : on garde les tailles Material 3 et on utilise les polices du système
         (Inter / Plus Jakarta Sans seront ajoutées à la fin du projet).
         letterSpacing = 0 PARTOUT : un espacement positif sépare les lettres arabes, qui doivent rester liées. -->
    <style name="TextAppearance.TrackGo.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
