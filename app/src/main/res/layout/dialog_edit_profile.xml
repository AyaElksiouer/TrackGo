<?xml version="1.0" encoding="utf-8"?>
<!-- Formulaire du profil (design : étape 6B du redesign).
     Fenêtre qui monte du bas (BottomSheetDialog), comme les détails de l'Historique.
     Les 5 champs gardent exactement les mêmes IDs et les mêmes règles de saisie qu'avant :
     ProfileFragment.kt les retrouve tous (+ 3 nouveaux IDs : le titre et les deux boutons).
     Structure : en-tête FIXE en haut, champs au milieu (ça défile si le clavier prend de la place),
     boutons FIXES en bas : ils restent toujours visibles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ===== En-tête : pastille + titre + sous-titre ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tg_space_xxl"
        android:paddingTop="@dimen/tg_space_xxl"
        android:paddingEnd="@dimen/tg_space_xxl"
        android:paddingBottom="@dimen/tg_space_l">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_profile_person"
                app:tint="?attr/colorOnPrimaryContainer" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tg_space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Le titre ("Renseigner mon profil" ou "Modifier le profil") est mis par ProfileFragment.kt -->
            <TextView
                android:id="@+id/txtEditProfileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_edit_button"
                android:textAlignment="viewStart"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_xs"
                android:text="@string/profile_form_subtitle"
                android:textAlignment="viewStart"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

    <!-- Séparateur fin -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/tg_stroke"
        android:background="?attr/colorOutlineVariant" />

    <!-- ===== Les 5 champs (cette partie défile si l'écran est petit ou si le clavier est ouvert) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/tg_space_xxl"
            android:paddingTop="@dimen/tg_space_l"
            android:paddingEnd="@dimen/tg_space_xxl"
            android:paddingBottom="@dimen/tg_space_l">

            <!-- Nom -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLastName"
                style="@style/Widget.TrackGo.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_last_name"
                app:startIconDrawable="@drawable/ic_profile_person"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Prénom -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFirstName"
                style="@style/Widget.TrackGo.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:hint="@string/hint_first_name"
                app:startIconDrawable="@drawable/ic_profile_person"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Âge -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutAge"
                style="@style/Widget.TrackGo.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:hint="@string/hint_age"
                app:startIconDrawable="@drawable/ic_profile_calendar"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Type de permis : liste de choix (le texte ne peut pas être tapé) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLicense"
                style="@style/Widget.TrackGo.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:hint="@string/hint_license"
                app:startIconDrawable="@drawable/ic_profile_license"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/dropdownLicense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- CIN / identifiant -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCin"
                style="@style/Widget.TrackGo.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:hint="@string/hint_cin"
                app:helperText="@string/helper_cin"
                app:helperTextEnabled="true"
                app:startIconDrawable="@drawable/ic_profile_badge"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="15"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ===== Boutons fixes en bas : Enregistrer (bleu) puis Annuler (tonal), pleine largeur ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/tg_space_xxl"
        android:paddingTop="@dimen/tg_space_s"
        android:paddingEnd="@dimen/tg_space_xxl"
        android:paddingBottom="@dimen/tg_space_xxl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelProfile"
            style="@style/Widget.TrackGo.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tg_space_m"
            android:text="@string/btn_cancel" />

    </LinearLayout>

</LinearLayout>