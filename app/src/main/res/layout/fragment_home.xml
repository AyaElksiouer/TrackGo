<?xml version="1.0" encoding="utf-8"?>
<!-- ÉTAPE 3A : écran Accueil.
     La carte occupe tout l'écran. Par-dessus : un header compact en haut et
     un panneau flottant fixe en bas. Les ids sont identiques à l'ancien écran :
     HomeFragment.kt les retrouve toujours.
     ÉTAPE 3B : seuls changements = les ids homeHeader et homePanel (voir plus bas).
     HomeFragment.kt s'en sert pour mesurer le header et le panneau et régler
     les marges de la carte (le logo Google reste visible au-dessus du panneau). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Carte Google Maps (plein écran) =====
         mapTouchOverlay est conservée (HomeFragment.kt la cherche) : elle est inoffensive. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/mapTouchOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ===== Header compact : titre + sélecteur de langue =====
         fitsSystemWindows : le header se place sous la barre d'état (heure, batterie).
         Le fond uni garde les icônes de la barre d'état lisibles en mode clair et sombre. -->
    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/home_welcome"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <!-- Sélecteur de langue : FR | EN | AR.
                 layoutDirection="ltr" : l'ordre FR, EN, AR reste le même même en arabe. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/language_selector_description"
                android:layoutDirection="ltr"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLangFr"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="@string/lang_fr"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLangEn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="@string/lang_en"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLangAr"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="@string/lang_ar"
                    android:textSize="12sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== Panneau flottant fixe (en bas) : livraison en cours ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/tg_space_m"
        android:layout_marginEnd="@dimen/tg_space_m"
        android:layout_marginBottom="@dimen/tg_space_m"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/tg_space_l">

            <!-- Petit libellé du panneau -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_tracking_title"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Affiché quand aucune commande n'est suivie (HomeFragment.kt, refreshUi) -->
            <TextView
                android:id="@+id/txtNoActiveDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_s"
                android:text="@string/home_no_active_delivery"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <!-- Ligne 1 : numéro de commande à gauche, badge de statut à droite.
                 Les deux textes sont remplis et affichés par HomeFragment.kt (refreshUi). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCurrentOrder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tg_space_s"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone"
                    tools:text="Commande : CMD-1002"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/txtDeliveryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/tg_space_s"
                    android:layout_marginTop="@dimen/tg_space_s"
                    android:background="@drawable/bg_tg_status_pill"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:visibility="gone"
                    tools:text="Statut : En cours"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Ligne 2 : distance parcourue -->
            <TextView
                android:id="@+id/txtDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:text="Distance parcourue : 0.45 km"
                tools:visibility="visible" />

            <!-- Ligne 3 : durée -->
            <TextView
                android:id="@+id/txtDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:text="Durée : 00:03:12"
                tools:visibility="visible" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>