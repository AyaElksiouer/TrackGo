<?xml version="1.0" encoding="utf-8"?>
<!-- NOUVEAU (redesign de l'Historique) : fenêtre qui monte du bas (BottomSheetDialog)
     quand on clique sur une livraison. Remplace l'ancienne boîte d'alerte.
     Tous les textes sont remplis par HistoryFragment.kt (showDetails) :
     "tools:text" ne sert qu'à l'aperçu dans Android Studio.
     Mêmes informations qu'avant : date, heure de début, distance, durée, statut
     (+ le numéro de commande quand il existe). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/tg_space_xxl"
    android:paddingTop="@dimen/tg_space_xxl"
    android:paddingEnd="@dimen/tg_space_xxl"
    android:paddingBottom="@dimen/tg_space_xxl">

    <!-- En-tête : badge vert + titre (et numéro de commande s'il existe) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_history_check"
                app:tint="?attr/colorOnTertiaryContainer" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tg_space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHistoryDetailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Détails de la livraison" />

            <TextView
                android:id="@+id/txtHistoryDetailsOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_xs"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Commande CMD-1002"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <!-- Séparateur fin -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/tg_stroke"
        android:layout_marginTop="@dimen/tg_space_m"
        android:background="?attr/colorOutlineVariant" />

    <!-- Bloc d'informations sur fond tonal -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tg_space_l"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/tg_space_l">

            <TextView
                android:id="@+id/txtHistoryDetailsDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Date : 02/11/2026" />

            <TextView
                android:id="@+id/txtHistoryDetailsStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Heure de début : 22:27" />

            <TextView
                android:id="@+id/txtHistoryDetailsDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Distance : 3.40 km" />

            <TextView
                android:id="@+id/txtHistoryDetailsDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Durée : 00:12:30" />

            <TextView
                android:id="@+id/txtHistoryDetailsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tg_space_m"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Statut : Livraison terminée" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bouton Fermer (tonal, pleine largeur) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHistoryDetailsClose"
        style="@style/Widget.TrackGo.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tg_space_xxl"
        android:text="@string/btn_close" />

</LinearLayout>